{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "secrets": {
          "type": "object",
          "additionalProperties": true,
          "required": ["llmModel"],
          "properties": {
            "llmModel": {
              "type": "string",
              "minLength": 1,
              "description": "LLM provider and model identifier, for example gemini/gemini-2.5-pro."
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clusterAdmin", "mutationNamespaces", "readNamespaces"],
          "properties": {
            "clusterAdmin": { "type": "boolean" },
            "mutationNamespaces": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "readNamespaces": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
