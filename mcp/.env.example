# ──────────────────────────────────────────────
# Skyflo MCP Server - Environment Configuration
# ──────────────────────────────────────────────

# Application
APP_NAME="Skyflo MCP Server"
APP_VERSION=0.0.0-dev
APP_DESCRIPTION="MCP Server for Skyflo"
DEBUG=false

# Logging
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# Retry Policy
# ──────────────────────────────────────────────

MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=60
RETRY_MAX_DELAY=300
RETRY_EXPONENTIAL_BASE=2.0

# External command reliability. Read-only commands may retry transient errors;
# mutation commands execute once and rely on post-action verification.
COMMAND_READ_TIMEOUT_SECONDS=30
COMMAND_MUTATION_TIMEOUT_SECONDS=120
COMMAND_TERMINATE_GRACE_SECONDS=2
COMMAND_MAX_RETRY_ATTEMPTS=3
COMMAND_RETRY_BASE_DELAY_SECONDS=0.5
COMMAND_RETRY_MAX_DELAY_SECONDS=5
COMMAND_RETRY_EXPONENTIAL_BASE=2.0

# ──────────────────────────────────────────────
# Engine Internal API
# Used by memory tools to call the engine's internal memory endpoints.
# Must match INTERNAL_API_KEY in the engine's environment.
# ──────────────────────────────────────────────

ENGINE_INTERNAL_URL=http://engine:8000
# REQUIRED: must match INTERNAL_API_KEY in the engine environment.
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=
